[node name="GuideText" type="RichTextLabel" parent="ControlsModal/MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 260)
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
text = "[b][color=#00e5ff]EVA LOCOMOTION & FLIGHT DYNAMICS:[/color][/b]
• [b]W / A / S / D[/b] — EVA Traversal across Lunar Regolith
• [b]Space[/b] — Jump (Simulating authentic 1.62 m/s² lunar gravity)
• [b]Shift / C[/b] — Toggle Gait Mode ([color=#39e58c]Suit Walk[/color] / [color=#00e5ff]Lunar Lope[/color])
• [b]Left Click[/b] — Engage orbital camera tracking
• [b]Mouse Scroll[/b] — Optical Zoom In / Out
• [b]ESC[/b] — System Configuration / Pause Menu

[b][color=#ff9d32]FIELD ARCHAEOLOGY & SCIENTIFIC CATION:[/color][/b]
• [b]RF Proximity Scanner & Minimap[/b] — Tracks distance and vector to buried Apollo artifacts.
• [b][E][/b] — Excavate subsurface anomaly and initiate ultrasonic decontamination.
• [b][F][/b] — Inspect authentic NASA Lunar Sample Compendium geological field specimens.
• [b][J][/b] — Access NASA Archaeological Flight Archive."

