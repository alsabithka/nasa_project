[node name="GuideText" type="RichTextLabel" parent="ControlsModal/MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 270)
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
text = "[b][color=#00f2ff]TACTICAL MOVEMENT & CONTROLS:[/color][/b]
• [b]W / A / S / D[/b] or Arrow Keys — Walk / EVA Maneuvering
• [b]Space[/b] — Jump (utilizing authentic 1.62 m/s² lunar gravity)
• [b]Shift / C[/b] — Toggle Gait Mode (Suit Walk / Lunar Lope)
• [b]Left Click[/b] — Lock mouse to orbit orbital survey camera
• [b]Mouse Scroll[/b] — Optical Zoom in/out
• [b]ESC[/b] — Release mouse / System Menu

[b][color=#ff9914]ARCHAEOLOGICAL PROTOCOLS:[/color][/b]
• [b]Tactical Radar & Minimap[/b] — Sweeping corner radar tracks proximity & bearings to subsurface anomalies.
• [b][E][/b] — Recover & decontaminate historical equipment when within range.
• [b][J][/b] — Access Archaeological Archives to review cataloged NASA missions."

