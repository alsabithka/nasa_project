[node name="GuideText" type="RichTextLabel" parent="ControlsModal/MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 260)
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
text = "[b]Movement:[/b]
• [b]W / A / S / D[/b] or Arrow Keys — Walk
• [b]Space[/b] — Jump (low lunar gravity — enjoy the arc!)
• [b]Left Click[/b] — Lock mouse / orbit camera
• [b]Mouse Scroll[/b] — Zoom in/out
• [b]ESC[/b] — Release mouse or open Pause Menu
• [b]Shift / C[/b] — Toggle lunar lope vs suit walk
• [b]V[/b] — Toggle 1st-person / 3rd-person view

[b]Archaeological Exploration:[/b]
• [b]Proximity Scanner[/b] — Always active. Signal beep accelerates as you approach a buried artefact.
• [b][E][/b] — Excavate when scanner reads ANOMALY BENEATH SURFACE.
• [b][J][/b] — Open Archaeological Journal (recovered history records).
• [b]ESC[/b] — Pause Menu (Resume, Settings, Quit)."

[node name="CloseControlsBtn" type="Button" parent="ControlsModal/MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(140, 42)
