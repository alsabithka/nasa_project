[resource]
default_font = ExtResource("Font_Sans")
default_font_size = 14

;; ── BUTTON ───────────────────────────────────────────────────
Button/colors/font_color = Color(0.91, 0.918, 0.929, 1)
Button/colors/font_hover_color = Color(0.91, 0.918, 0.929, 1)
Button/colors/font_pressed_color = Color(0.027, 0.035, 0.051, 1)
Button/colors/font_disabled_color = Color(0.486, 0.529, 0.592, 1)
Button/colors/font_focus_color = Color(0.91, 0.918, 0.929, 1)
Button/fonts/font = ExtResource("Font_SansMedium")
Button/font_sizes/font_size = 14
Button/styles/normal = SubResource("SB_ButtonNormal")
Button/styles/hover = SubResource("SB_ButtonHover")
Button/styles/pressed = SubResource("SB_ButtonPressed")
Button/styles/disabled = SubResource("SB_ButtonDisabled")
Button/styles/focus = SubResource("SB_Focus")

;; ── LABEL ────────────────────────────────────────────────────
Label/colors/font_color = Color(0.91, 0.918, 0.929, 1)
Label/fonts/font = ExtResource("Font_Sans")
Label/font_sizes/font_size = 14

;; ── RICH TEXT LABEL ──────────────────────────────────────────
RichTextLabel/colors/default_color = Color(0.91, 0.918, 0.929, 1)
RichTextLabel/fonts/normal_font = ExtResource("Font_Sans")
RichTextLabel/fonts/bold_font = ExtResource("Font_SansBold")
RichTextLabel/fonts/mono_font = ExtResource("Font_Mono")
RichTextLabel/font_sizes/normal_font_size = 14
RichTextLabel/font_sizes/bold_font_size = 14
RichTextLabel/font_sizes/italics_font_size = 14
RichTextLabel/font_sizes/bold_italics_font_size = 14

;; ── PANEL / PANEL CONTAINER ───────────────────────────────────
Panel/styles/panel = SubResource("SB_Panel")
PanelContainer/styles/panel = SubResource("SB_Panel")

;; ── PROGRESS BAR ─────────────────────────────────────────────
ProgressBar/styles/background = SubResource("SB_ProgressBg")
ProgressBar/styles/fill = SubResource("SB_ProgressFill")
ProgressBar/colors/font_color = Color(0.91, 0.918, 0.929, 1)
ProgressBar/font_sizes/font_size = 12

;; ── SEPARATOR ────────────────────────────────────────────────
HSeparator/styles/separator = SubResource("SB_Separator")
VSeparator/styles/separator = SubResource("SB_Separator")

;; ── TAB CONTAINER ────────────────────────────────────────────
TabContainer/colors/font_selected_color = Color(0.98, 0.78, 0.2, 1)
TabContainer/colors/font_unselected_color = Color(0.639, 0.675, 0.725, 1)
TabContainer/colors/font_disabled_color = Color(0.486, 0.529, 0.592, 1)
TabContainer/fonts/font = ExtResource("Font_SansMedium")
TabContainer/font_sizes/font_size = 14
TabContainer/styles/tab_selected = SubResource("SB_TabSelected")
TabContainer/styles/tab_unselected = SubResource("SB_TabUnselected")
TabContainer/styles/panel = SubResource("SB_Panel")

;; ── SCROLL CONTAINER ─────────────────────────────────────────
HScrollBar/styles/scroll = SubResource("SB_ScrollBg")
HScrollBar/styles/grabber = SubResource("SB_ScrollGrabber")
HScrollBar/styles/grabber_hover = SubResource("SB_ScrollGrabberHover")
VScrollBar/styles/scroll = SubResource("SB_ScrollBg")
VScrollBar/styles/grabber = SubResource("SB_ScrollGrabber")
VScrollBar/styles/grabber_hover = SubResource("SB_ScrollGrabberHover")

;; ── LINE EDIT ────────────────────────────────────────────────
LineEdit/colors/font_color = Color(0.91, 0.918, 0.929, 1)
LineEdit/colors/font_placeholder_color = Color(0.486, 0.529, 0.592, 1)
LineEdit/styles/normal = SubResource("SB_ButtonNormal")
LineEdit/styles/focus = SubResource("SB_Focus")


;; ── TYPE VARIATIONS (Phase 2) ────────────────────────────────
;; Use:  label.theme_type_variation = &"TitleLabel"
CaptionLabel/base_type = &"Label"
CaptionLabel/colors/font_color = Color(0.639, 0.675, 0.725, 1)
CaptionLabel/font_sizes/font_size = 12

LeadLabel/base_type = &"Label"
LeadLabel/fonts/font = ExtResource("Font_SansMedium")
LeadLabel/font_sizes/font_size = 16

TitleLabel/base_type = &"Label"
TitleLabel/fonts/font = ExtResource("Font_SansBold")
TitleLabel/font_sizes/font_size = 20

DisplayLabel/base_type = &"Label"
DisplayLabel/fonts/font = ExtResource("Font_SansBold")
DisplayLabel/font_sizes/font_size = 28

HeroLabel/base_type = &"Label"
HeroLabel/fonts/font = ExtResource("Font_SansBold")
HeroLabel/font_sizes/font_size = 40

;; Live / simulated numerals — always monospaced (separates data from prose)
StatLabel/base_type = &"Label"
StatLabel/colors/font_color = Color(0.502, 0.8, 1, 1)
StatLabel/fonts/font = ExtResource("Font_MonoMedium")
StatLabel/font_sizes/font_size = 16

StatLabelLarge/base_type = &"Label"
StatLabelLarge/colors/font_color = Color(0.502, 0.8, 1, 1)
StatLabelLarge/fonts/font = ExtResource("Font_MonoMedium")
StatLabelLarge/font_sizes/font_size = 28

GoldLabel/base_type = &"Label"
GoldLabel/colors/font_color = Color(0.98, 0.78, 0.2, 1)

;; ── BUTTON VARIATIONS ────────────────────────────────────────
;; Gold text on gold fill is forbidden → ink-900 text on gold.
PrimaryButton/base_type = &"Button"
PrimaryButton/colors/font_color = Color(0.027, 0.035, 0.051, 1)
PrimaryButton/colors/font_hover_color = Color(0.027, 0.035, 0.051, 1)
PrimaryButton/colors/font_pressed_color = Color(0.027, 0.035, 0.051, 1)
PrimaryButton/colors/font_focus_color = Color(0.027, 0.035, 0.051, 1)
PrimaryButton/colors/font_disabled_color = Color(0.486, 0.529, 0.592, 1)
PrimaryButton/fonts/font = ExtResource("Font_SansBold")
PrimaryButton/styles/normal = SubResource("SB_PrimaryNormal")
PrimaryButton/styles/hover = SubResource("SB_PrimaryHover")
PrimaryButton/styles/pressed = SubResource("SB_PrimaryPressed")

GhostButton/base_type = &"Button"
GhostButton/styles/normal = SubResource("SB_GhostNormal")
GhostButton/styles/hover = SubResource("SB_GhostHover")

TabButton/base_type = &"Button"
TabButton/colors/font_color = Color(0.639, 0.675, 0.725, 1)
TabButton/colors/font_hover_color = Color(0.91, 0.918, 0.929, 1)
TabButton/colors/font_pressed_color = Color(0.98, 0.78, 0.2, 1)
