TabButton/colors/font_focus_color = Color(0.91, 0.918, 0.929, 1)
TabButton/styles/normal = SubResource("SB_TabBtnNormal")
TabButton/styles/hover = SubResource("SB_TabBtnHover")
TabButton/styles/pressed = SubResource("SB_TabBtnOn")
TabButton/styles/hover_pressed = SubResource("SB_TabBtnOn")

;; ── PANEL VARIATIONS ─────────────────────────────────────────
ArchiveCard/base_type = &"PanelContainer"
ArchiveCard/styles/panel = SubResource("SB_CardHard")

HudPanel/base_type = &"PanelContainer"
HudPanel/styles/panel = SubResource("SB_HudPanel")
